# Copy to .env and fill in. Bun auto-loads .env; the Agent SDK subprocess
# inherits process.env, so no dotenv package is needed.
#
# NOTE: the SDKs do NOT read .env themselves. Under plain Node you would have to
# load it yourself (`node --env-file=.env`, or the dotenv package).

# Required for every lab. Get one at https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Only needed if you enable the github MCP server in .mcp.json.
# Demonstrates ${VAR} expansion in .mcp.json (exam Task 2.4) — the token
# never gets committed, only the reference to it.
# GITHUB_TOKEN=ghp_...

# Optional cost guard applied by src/runtime/run.ts via `maxBudgetUsd`.
# Every agent lab stops with an `error_max_budget_usd` result past this.
LAB_MAX_BUDGET_USD=2.00
